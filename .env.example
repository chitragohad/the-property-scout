# Gemini (required for LLM turns from Phase 4+)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Any Gemini prebuilt TTS voice (see /voice/config available_voices). Recommended for Property Scout:
# Charon (informative), Kore (firm), Iapetus (clear), Rasalgethi (informative), Schedar (even)
GEMINI_VOICE=Charon
LLM_TEMPERATURE=0.2
LLM_CONFIDENCE_THRESHOLD=0.6

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Production: set to your Vercel web URL(s), comma-separated
# CORS_ORIGINS=https://property-scout-web.vercel.app
# Allow Preview deployments (https://*.vercel.app)
CORS_ALLOW_VERCEL_PREVIEWS=false

# Leave empty for default SQLite at data/property_scout.db
# Vercel: use Vercel Postgres / Neon pooled URL, e.g.
# DATABASE_URL=postgresql+psycopg://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=

# Redis for sessions on Vercel (required for serverless). Local: leave empty (in-memory).
# REDIS_URL=rediss://default:PASSWORD@HOST:6379
REDIS_URL=
SESSION_TTL_SECONDS=86400

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production (Vercel web project): set API_ORIGIN to the FastAPI deployment URL.
# Client auto-uses /api-backend on non-localhost; do NOT point API_ORIGIN at the web URL.
# API_ORIGIN=https://the-property-scout-api.vercel.app
API_ORIGIN=
# OSM enrichment: overpass (live Overpass API) | static (deterministic dev/CI POIs)
OSM_MODE=overpass

# n8n webhook for shortlist PDF email (optional)
N8N_WEBHOOK_URL=

# Ingest (optional). Prefer a local JSON dump of scrubbed pins.
# INGEST_JSON_PATH=/path/to/listings.json
# INGEST_SOURCE_URL=
